{
  "name": "@apollozhangongithub/terminal-style-ui",
  "version": "0.1.2",
  "type": "module",
  "description": "终端风格渲染：Markdown / 任意文件 → 终端 TUI 同款 ANSI → 格子化 HTML；附命令行 tmd",
  "main": "index.js",
  "bin": {
    "tmd": "bin/tmd.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "chalk": "4.1.2",
    "cli-highlight": "2.1.11",
    "cross-spawn": "7.0.6",
    "esbuild": "^0.28.2",
    "get-east-asian-width": "1.6.0",
    "highlight.js": "10.7.3",
    "marked": "18.0.5",
    "typebox": "1.1.38"
  },
  "files": [
    "index.js",
    "core.js",
    "ansi-to-html.js",
    "highlight-themes.js",
    "terminal.css",
    "bin/tmd.mjs",
    "dist/runtime.mjs",
    "dist/themes/",
    "dist/ttu-core.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ApolloZhangOnGithub/terminal-style-ui.git",
    "directory": "terminal-style-ui-web"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "terminal",
    "tui",
    "ansi",
    "preview",
    "cli",
    "claude-code",
    "syntax-highlight"
  ]
